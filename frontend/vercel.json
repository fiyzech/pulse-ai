{
  "rewrites": [
    {
      "source": "/api/coingecko/:path*",
      "destination": "https://api.coingecko.com/api/v3/:path*"
    },
    {
      "source": "/api/binance/:path*",
      "destination": "https://api.binance.com/api/v3/:path*"
    },
    {
      "source": "/api/newsapi/:path*",
      "destination": "https://newsapi.org/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
